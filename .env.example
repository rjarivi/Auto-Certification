# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# Option A — Neon (free): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Option B — Railway PostgreSQL plugin: auto-injected as DATABASE_URL
# Option C — Local dev: leave blank (uses JSON files instead)
DATABASE_URL=

# ── Object Storage ────────────────────────────────────────────────────────────
# Shared for both AWS S3 and Cloudflare R2 (use R2 API token as the key/secret).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Cloudflare R2 (recommended — free tier) ----------------------------------
# 1. Create R2 bucket in Cloudflare dashboard
# 2. Enable "Public access" on the bucket → copy the r2.dev URL
# 3. Create an R2 API token with Object Read & Write permissions
# 4. Fill in the four vars below; leave STORAGE_ENDPOINT_URL blank for plain AWS S3
S3_BUCKET_NAME=autocert-files
STORAGE_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=https://pub-<TOKEN>.r2.dev
AWS_REGION=auto

# --- AWS S3 (alternative) -----------------------------------------------------
# S3_BUCKET_NAME=autocert-files
# AWS_REGION=us-east-1
# STORAGE_ENDPOINT_URL=       ← leave blank for AWS S3
# STORAGE_PUBLIC_URL=         ← leave blank for AWS S3

# ── AWS SES (optional — only needed for "AWS SES" email mode) ─────────────────
# Sender email must be verified in SES console.
SES_REGION=us-east-1
SES_FROM_EMAIL=
