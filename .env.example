# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=production

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Railway auto-injects DATABASE_URL when you add the PostgreSQL plugin.
# For local dev: postgresql://user:password@localhost:5432/autocert
DATABASE_URL=

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# Leave S3_BUCKET_NAME empty to use local disk (dev mode).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# ── AWS SES (optional — only needed for "AWS SES" email mode) ─────────────────
# Sender email must be verified in SES console.
SES_REGION=us-east-1
SES_FROM_EMAIL=
